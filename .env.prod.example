# FieldDraft — PRODUCTION secrets/config for docker-compose.prod.yml.
#
# Copy to `.env.prod` on the V-server and fill in REAL values. In the Ansible
# flow these are rendered from an Ansible-Vault–encrypted group_vars file
# (deploy/ansible/group_vars/all.example.yml) — NEVER commit the filled-in file.
#
# Load + validate the stack:
#   set -a; . ./.env.prod; set +a
#   docker compose -f docker-compose.prod.yml config
# or pass directly:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# ── Domain / TLS ────────────────────────────────────────────────────────────
# The public hostname. Caddy auto-issues a Let's Encrypt cert for it.
# For local testing use `localhost` (Caddy then uses its internal CA).
DOMAIN=fielddraft.example.com
# ACME account email (Let's Encrypt expiry notices). Leave empty for localhost.
TLS_EMAIL=ops@example.com

# ── Image registry / version ────────────────────────────────────────────────
# GHCR namespace the deploy pulls from, and the tag to run.
# `ansible-playbook deploy.yml -e version=<tag>` overrides TAG for rollback.
REGISTRY=ghcr.io/sorokan/fielddraft
TAG=latest

# ── Database (MariaDB — no host-exposed port) ───────────────────────────────
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=fielddraft
DB_USER=fielddraft
DB_PASSWORD=change-me-app-password

# ── Operator admin (seeded on first boot only) ──────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password

# ── Agent service tokens (PO + coding desktop agents, WP6) ──────────────────
# Empty disables the agent API. The two ClaudeDraft agents authenticate with
# these (PO_SERVICE_TOKEN → po scope, CODING_SERVICE_TOKEN → coding scope).
PO_SERVICE_TOKEN=change-me-po-token
CODING_SERVICE_TOKEN=change-me-coding-token

# ── Server-side CGAL meshing (mesher service) ───────────────────────────────
# Dispatcher workers in the Go server (≈ number of mesher replicas), parallel
# jobs per mesher container, TBB threads per job (0 = all cores), job timeout.
MESH_WORKERS=2
MESH_CONCURRENCY=2
MESH_THREADS=0
MESH_TIMEOUT_SEC=300

# ── Tickets (IssueVault — the only backend, ticket #346) ────────────────────
# URL/PROJECT are optional — empty falls back to the code default. INSTALLATION
# is this deployment's own id (per-installation isolation); TOKEN is an
# installation-bound agent token and is SECRET (Vault). Without a token every
# ticket call fails 401 upstream. See DEPLOY.md.
ISSUEVAULT_URL=https://issuevault.203.0.113.10.sslip.io/api/v1
ISSUEVAULT_PROJECT=744dc267-24dd-470d-8f06-2f56bd412349
ISSUEVAULT_INSTALLATION=change-me-installation-id
ISSUEVAULT_TOKEN=change-me-issuevault-token

# ── KI-Assistent (Chat-Popup, Ticket #347) ─────────────────────────────────
# Der Go-Server hält den OpenRouter-Key und proxyt die Modell-Aufrufe (der
# Agent-Loop selbst läuft im Browser). OHNE Key ist das Feature schlicht AUS:
# /api/aichat/config meldet enabled:false und die App blendet den Chat aus.
# AICHAT_MODELS überschreibt die Allowlist des Proxys (kommagetrennt); ohne sie
# gelten die Defaults aus server/aichat.go. Das Vision-Modell MUSS mit in der
# Liste stehen, sonst kippt der Turn, sobald ein Screenshot dranhängt.
# BESSER als die Variable: den Key in eine Datei legen und nur den PFAD setzen.
# Eine Env-Variable steht in `docker inspect`, in /proc/<pid>/environ und erbt an
# jeden Kindprozess; eine 0600-Datei tut das nicht.
#   printf '%s' 'sk-or-…' > secrets/openrouter.key
#   chmod 600 secrets/openrouter.key
# Der Pfad ist der IM CONTAINER — docker-compose.prod.yml mountet die Host-Datei
# secrets/openrouter.key read-only genau dorthin. Beim Ansible-Deploy macht das
# deploy.yml aus dem Vault; von Hand gilt: die Datei muss EXISTIEREN (leer = aus),
# sonst legt Docker dort ein root-eigenes Verzeichnis an.
#OPENROUTER_API_KEY_FILE=/run/secrets/openrouter.key
OPENROUTER_API_KEY=
#AICHAT_MODELS=google/gemini-3-flash-preview,anthropic/claude-sonnet-4.5
# Assistent-Anfragen pro Nutzer und Tag (Default 300, 0 = aus).
#AICHAT_DAILY_QUOTA=300
# Pinnt den Origin der Chat-POSTs auf den öffentlichen Namen dieses Deployments.
#AICHAT_ALLOWED_ORIGINS=https://fielddraft.example.com
