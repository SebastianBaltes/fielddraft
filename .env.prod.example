# FieldDraft — PRODUCTION secrets/config for docker-compose.prod.yml.
#
# Copy to `.env.prod` on the V-server and fill in REAL values. In the Ansible
# flow these are rendered from an Ansible-Vault–encrypted group_vars file
# (deploy/ansible/group_vars/all.example.yml) — NEVER commit the filled-in file.
#
# Load + validate the stack:
#   set -a; . ./.env.prod; set +a
#   docker compose -f docker-compose.prod.yml config
# or pass directly:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# ── Domain / TLS ────────────────────────────────────────────────────────────
# The public hostname. Caddy auto-issues a Let's Encrypt cert for it.
# For local testing use `localhost` (Caddy then uses its internal CA).
DOMAIN=fielddraft.example.com
# ACME account email (Let's Encrypt expiry notices). Leave empty for localhost.
TLS_EMAIL=ops@example.com

# ── Image registry / version ────────────────────────────────────────────────
# GHCR namespace the deploy pulls from, and the tag to run.
# `ansible-playbook deploy.yml -e version=<tag>` overrides TAG for rollback.
REGISTRY=ghcr.io/sorokan/fielddraft
TAG=latest

# ── Database (MariaDB — no host-exposed port) ───────────────────────────────
DB_ROOT_PASSWORD=change-me-root-password
DB_NAME=fielddraft
DB_USER=fielddraft
DB_PASSWORD=change-me-app-password

# ── Operator admin (seeded on first boot only) ──────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password

# ── Agent service tokens (PO + coding desktop agents, WP6) ──────────────────
# Empty disables the agent API. The two ClaudeDraft agents authenticate with
# these (PO_SERVICE_TOKEN → po scope, CODING_SERVICE_TOKEN → coding scope).
PO_SERVICE_TOKEN=change-me-po-token
CODING_SERVICE_TOKEN=change-me-coding-token
