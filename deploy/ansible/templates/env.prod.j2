# Managed by Ansible (deploy.yml) — do NOT edit by hand. Secrets come from the
# Ansible-Vault group_vars/vault.yml. Mirrors .env.prod.example.
DOMAIN={{ domain }}
TLS_EMAIL={{ tls_email }}
REGISTRY={{ registry }}
TAG={{ version }}
DB_ROOT_PASSWORD={{ vault_db_root_password }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ vault_db_password }}
ADMIN_EMAIL={{ vault_admin_email }}
ADMIN_PASSWORD={{ vault_admin_password }}

# AI assistant (ticket #347). The KEY ITSELF IS NOT HERE — deploy.yml writes it
# to {{ app_dir }}/secrets/openrouter.key (0600) and the compose file mounts that
# read-only. This env only names the path INSIDE the container. Leave
# vault_openrouter_api_key unset and the assistant is simply off.
OPENROUTER_API_KEY_FILE=/run/secrets/openrouter.key
AICHAT_MODELS={{ aichat_models | default('') }}
AICHAT_DAILY_QUOTA={{ aichat_daily_quota | default('') }}
AICHAT_ALLOWED_ORIGINS=https://{{ domain }}
