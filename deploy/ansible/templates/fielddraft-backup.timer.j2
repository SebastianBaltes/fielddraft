# Managed by Ansible (backup.yml).
[Unit]
Description=Run the FieldDraft backup nightly

[Timer]
# Nightly at {{ '%02d' | format(backup_hour) }}:00 server local time, with a
# randomized delay to avoid a thundering herd; catch up if the host was off.
OnCalendar=*-*-* {{ '%02d' | format(backup_hour) }}:00:00
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
