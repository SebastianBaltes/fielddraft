# Rust
/target
**/*.rs.bk
Cargo.lock

# Node
node_modules/
dist/
dist-ssr/
*.local

# wasm-pack output
/crates/kernel/pkg/
/web/src/wasm/

# Agent worktrees / scratch
/.claude/

# Per-instance deployment/webapp config (ports, instance name).
# fielddraft vs fielddraft-a run side by side from a shared checkout
# layout but must not collide on ports. Copy the *.example files per
# checkout. See .env.example and .claudedraft.json.example.
/.env
# Webapp launcher contract read by the ClaudeDraft daemon (static JSON, no
# .env interpolation), so its port must be set per instance here too.
/.claudedraft.json

# Editor / OS
.DS_Store
*.log
.vscode/
!.vscode/extensions.json
.idea/

# In-app issue tickets — runtime artifacts (screenshots + project JSON)
# filed via the "Report Issue" dialog. Processed by the agent locally;
# the format is documented in tickets/README.md (tracked).
/tickets/open/
/tickets/done/

# Test artifacts
/web/coverage/
/web/playwright-report/
/web/test-results/
/web/.playwright/

# TypeScript incremental build cache
*.tsbuildinfo

# Root test artifacts
/test-results/
CLAUDE.md.bak*

# Scratch uploads (screenshots, pasted clipboard images)
/.uploads/

# Large research PDFs — kept local only, not in git history
/docs/Literatur/

# Compiled Go server binary (build artifact — was accidentally tracked)
/server/server

# Production secrets / real ansible config (never commit)
.env.prod
deploy/ansible/inventory.ini
deploy/ansible/group_vars/all.yml
deploy/ansible/group_vars/vault.yml
