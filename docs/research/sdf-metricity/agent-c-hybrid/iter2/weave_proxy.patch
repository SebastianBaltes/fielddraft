+        },
+        SceneData {
+            name: "box_union_cyl",
+            features: {
+                let (f, _) = regen(&[
+                    FeatureCall::new("box", id(1), json!({ "half_extents": [10.0, 10.0, 10.0] })),
+                    FeatureCall::new(
+                        "cylinder",
+                        id(2),
+                        json!({
+                            "radius": 6.0,
+                            "half_height": 14.0,
+                            "translate": [8.0, 0.0, 0.0],
+                            "op": "add",
+                            "targets": "qCreatedBy(1)",
+                        }),
+                    ),
+                ]);
+                f
+            },
+            fillets: vec![],
+        },
+        SceneData {
+            // Zylinder-Boss mittig auf der Box-Oberseite: die konkave Naht
+            // ist ein geschlossener Kreis — die Band-Topologie, die c-M2
+            // (Torus-Band) als sauberste Manifold-Konfiguration ausweist.
+            name: "box_boss_cyl",
+            features: {
+                let (f, _) = regen(&[
+                    FeatureCall::new("box", id(1), json!({ "half_extents": [10.0, 10.0, 10.0] })),
+                    FeatureCall::new(
+                        "cylinder",
+                        id(2),
+                        json!({
+                            "radius": 6.0,
+                            "half_height": 8.0,
+                            "translate": [0.0, 0.0, 10.0],
+                            "op": "add",
+                            "targets": "qCreatedBy(1)",
+                        }),
+                    ),
+                ]);
+                f
+            },
+            fillets: vec![],
+        },
+        {
+            let (features, fillets) = build_fillet_scene(3.0);
+            SceneData { name: "fillet_step", features, fillets }
+        },
+    ];
+
+    let mut summary_rows: Vec<String> = Vec::new();
+    let mut band_rows: Vec<String> = Vec::new();
+    let mut blend_rows: Vec<String> = Vec::new();
+    let mut facts = BTreeMap::<String, serde_json::Value>::new();
+
+    for scene in &scenes {
+        eprintln!("── scene {} ──", scene.name);
+        // IST-Feld: dekodierte Features (+ Fillets) — identisch zum
+        // Mesher-/Render-CSG (`build_bounded_*_rounded`).
+        let node: CsgNode = CsgNode::from_decoded(&scene.features)
+            .apply_edge_fillets(&scene.fillets);
+        let field = CsgField::visual(&node);
+        let bounded = BoundedCsg::from_csg(&node);
+        let compiled = compile_body(&bounded);
+        let tape = TapeField { compiled: &compiled };
+
+        let a = node.aabb();
+        // Domain BEWUSST über die Body-AABB hinaus gepolstert (20 % der
+        // größten Kante): die Phantom-Flächen-Regionen der Iteration 1
+        // (überstehende Operanden, z. B. über der Taschenöffnung) liegen
+        // AUSSERHALB der Ergebnis-AABB — ohne Polster misst man dort nie.
+        let (mut lo, mut hi) = (
+            [a.min[0] as f64, a.min[1] as f64, a.min[2] as f64],
+            [a.max[0] as f64, a.max[1] as f64, a.max[2] as f64],
+        );
+        let pad = 0.2 * (0..3).map(|k| hi[k] - lo[k]).fold(0.0f64, f64::max);
+        for k in 0..3 {
+            lo[k] -= pad;
+            hi[k] += pad;
+        }
+
+        // Ground Truth auf der Nullmenge des IST-Felds (Harness-Verfahren).
+        let gt_opts = GtOptions { grid: if scene.fillets.is_empty() { 96 } else { 128 }, ..GtOptions::default() };
+        let t0 = std::time::Instant::now();
+        let gt = GroundTruth::build(&field, lo, hi, &gt_opts);
+        eprintln!("  GT built: {} surface pts, {:.1}s", gt.n_surface_points(), t0.elapsed().as_secs_f64());
+        let model_size = gt.model_size;
+
+        // Punktmengen (deterministisch, Seeds publiziert).
+        let mut pts = sample_uniform(lo, hi, 3000, 42);
+        let near = sample_near_surface(&gt, 3000, 0.05, 43);
+        pts.extend_from_slice(&near);
+        let t0 = std::time::Instant::now();
+        let dtrue: Vec<f64> = {
+            use rayon::prelude::*;
+            pts.par_iter().map(|&p| gt.distance(p)).collect()
+        };
+        eprintln!("  GT distances: {} pts, {:.1}s", pts.len(), t0.elapsed().as_secs_f64());
+
+        // ── Kernel-Artefakt 1: Produktions-Weave (`weave_all`) ──────────
+        let woven = weave_all(&scene.features);
+        assert_eq!(woven.len(), 1, "one body expected");
+        let (brep, placement) = &woven[0];
+        let mut kinds = BTreeMap::<&'static str, usize>::new();
+        for f in &brep.faces {
+            *kinds.entry(fielddraft_kernel::brep::face_export::surface_kind(&f.surface)).or_insert(0) += 1;
+        }
+        facts.insert(
+            format!("{}__weave_all", scene.name),
+            json!({
+                "faces": brep.face_count(),
+                "edges": brep.edge_count(),
+                "vertices": brep.vertex_count(),
+                "face_kinds": kinds.iter().map(|(k, v)| (k.to_string(), *v)).collect::<BTreeMap<_, _>>(),
+                "note": "production weave (Body::ensure_brep route) — edge fillets are NOT applied here (build_bounded_for_body_local has no edge_fillets parameter)",
+            }),
+        );
+
+        // Feld + Tape in die Summary.
+        for (vname, f) in [("field_visual", &field as &dyn Field), ("tape", &tape as &dyn Field)] {
+            let b = banded(f, &pts, &dtrue, model_size);
+            let grad = gradient_report(f, model_size, &pts, &near, 44);
+            let ns = bench_ns(f, &pts, 200_000);
+            summary_rows.push(format!(
+                "{},{},na,{},{},{},{},{},{},{},{:.4},{:.4},{:.4},{:.4},{:.1}",
+                scene.name, vname,
+                stats_csv(&b.near_out), stats_csv(&b.near_in),
+                stats_csv(&b.mid_out), stats_csv(&b.mid_in),
+                stats_csv(&b.far_out), stats_csv(&b.far_in),
+                stats_csv(&b.overall),
+                grad.dev.mean, grad.dev.p95, grad.dev.max, grad.seam_jump.p95, ns
+            ));
+        }
+
+        // ── Proxy aus tessellate_brep bei 3 tol-Stufen ──────────────────
+        let mut proxy_for_blend: Option<(TriMesh, Bvh)> = None;
+        for tol in [0.2f64, 0.05, 0.01] {
+            let t0 = std::time::Instant::now();
+            let tess = tessellate_brep(brep, placement, tol);
+            match tess {
+                Ok(mesh) => {
+                    let tm = TriMesh::from_kernel(&mesh);
+                    let bvh = Bvh::build(&tm);
+                    let build_ms = t0.elapsed().as_secs_f64() * 1e3;
+                    let proxy = ProxyField { mesh: &tm, bvh: &bvh, sign_field: &field };
+                    let b = banded(&proxy, &pts, &dtrue, model_size);
+                    let grad = gradient_report(&proxy, model_size, &pts, &near, 44);
+                    let ns = bench_ns(&proxy, &pts, 200_000);
+                    eprintln!(
+                        "  proxy tol={tol}: {} tris, build {build_ms:.1} ms, near_out max {:.4} mm, {ns:.0} ns/q",
+                        tm.t.len(), b.near_out.max
+                    );
+                    summary_rows.push(format!(
+                        "{},proxy_tess,{tol},{},{},{},{},{},{},{},{:.4},{:.4},{:.4},{:.4},{:.1}",
+                        scene.name,
+                        stats_csv(&b.near_out), stats_csv(&b.near_in),
+                        stats_csv(&b.mid_out), stats_csv(&b.mid_in),
+                        stats_csv(&b.far_out), stats_csv(&b.far_in),
+                        stats_csv(&b.overall),
+                        grad.dev.mean, grad.dev.p95, grad.dev.max, grad.seam_jump.p95, ns
+                    ));
+                    facts.insert(
+                        format!("{}__tessellate_tol{}", scene.name, tol),
+                        json!({ "ok": true, "tris": tm.t.len(), "build_ms": build_ms }),
+                    );
+                    if (tol - 0.05).abs() < 1e-9 {
+                        proxy_for_blend = Some((tm, bvh));
+                    }
+                }
+                Err(e) => {
+                    eprintln!("  proxy tol={tol}: tessellate_brep FAILED: {e}");
+                    facts.insert(
+                        format!("{}__tessellate_tol{}", scene.name, tol),
+                        json!({ "ok": false, "error": e }),
+                    );
+                }
+            }
+        }
+
+        // ── DC-Render-Mesh als Fallback-Artefakt ────────────────────────
+        // Für Fillet-Szenen (das einzige Artefakt mit Fillet-Geometrie,
+        // #350) und für Szenen, deren Weave-Tesselation scheitert.
+        let mut dc_meshes: Vec<(String, TriMesh)> = Vec::new();
+        if !scene.fillets.is_empty() || proxy_for_blend.is_none() {
+            let resolutions: &[u32] = if scene.fillets.is_empty() { &[256] } else { &[128, 256] };
+            for &res in resolutions {
+                let t0 = std::time::Instant::now();
+                let m = fielddraft_kernel::dc::dual_contour(&bounded, res);
+                let tm = TriMesh::from_kernel(&m);
+                eprintln!(
+                    "  dc res={res}: {} tris, {:.1}s",
+                    tm.t.len(),
+                    t0.elapsed().as_secs_f64()
+                );
+                dc_meshes.push((format!("proxy_dc{res}"), tm));
+            }
+            for (vname, tm) in &dc_meshes {
+                let bvh = Bvh::build(tm);
+                let proxy = ProxyField { mesh: tm, bvh: &bvh, sign_field: &field };
+                let b = banded(&proxy, &pts, &dtrue, model_size);
+                let grad = gradient_report(&proxy, model_size, &pts, &near, 44);
+                let ns = bench_ns(&proxy, &pts, 200_000);
+                summary_rows.push(format!(
+                    "{},{vname},na,{},{},{},{},{},{},{},{:.4},{:.4},{:.4},{:.4},{:.1}",
+                    scene.name,
+                    stats_csv(&b.near_out), stats_csv(&b.near_in),
+                    stats_csv(&b.mid_out), stats_csv(&b.mid_in),
+                    stats_csv(&b.far_out), stats_csv(&b.far_in),
+                    stats_csv(&b.overall),
+                    grad.dev.mean, grad.dev.p95, grad.dev.max, grad.seam_jump.p95, ns
+                ));
+            }
+        }
+
+        // ── S3: gefilleteter Direkt-Weave (c-M1-Route) ───────────────────
+        if !scene.fillets.is_empty() {
+            // Direkter Weave des gefilleteten CSG — webt der Weaver die
+            // Blend-Zone als eigene Face? (c-M1 sagt ja.)
+            let bb = bounded.aabb();
+            let largest = bb.size().into_iter().fold(0.0_f32, f32::max);
+            let min_cell = (largest / 48.0).clamp(1e-3, 10.0);
+            let octree = fielddraft_kernel::brep::octree::Octree::build(&bounded, min_cell);
+            let fbrep = fielddraft_kernel::brep::weaving::weave(&bounded, &octree);
+            let blend_faces = fbrep
+                .faces
+                .iter()
+                .filter(|f| {
+                    matches!(
+                        &f.surface,
+                        SurfaceGeometry::Analytic { surface: HalfSpace::Blend { .. }, .. }
+                    )
+                })
+                .count();
+            let mut fkinds = BTreeMap::<&'static str, usize>::new();
+            for f in &fbrep.faces {
+                *fkinds
+                    .entry(fielddraft_kernel::brep::face_export::surface_kind(&f.surface))
+                    .or_insert(0) += 1;
+            }
+            let tess_res = tessellate_brep(&fbrep, &Transform::IDENTITY, 0.05);
+            facts.insert(
+                format!("{}__direct_filleted_weave", scene.name),
+                json!({
+                    "faces": fbrep.face_count(),
+                    "blend_faces": blend_faces,
+                    "face_kinds": fkinds.iter().map(|(k, v)| (k.to_string(), *v)).collect::<BTreeMap<_, _>>(),
+                    "tessellate_result": match &tess_res {
+                        Ok(m) => json!({ "ok": true, "tris": m.indices.len() / 3 }),
+                        Err(e) => json!({ "ok": false, "error": e }),
+                    },
+                }),
+            );
+            eprintln!(
+                "  direct filleted weave: {} faces, {} blend faces; tessellate: {:?}",
+                fbrep.face_count(),
+                blend_faces,
+                tess_res.as_ref().map(|m| m.indices.len() / 3).map_err(|e| e.clone())
+            );
+
+            // ── Fillet-Band: Kapsel um die maskierte Kante, r ≤ 2.5·r_f ──
+            let fillet = &scene.fillets[0];
+            let poly: Vec<V3> = fillet
+                .mask_polyline
+                .iter()
+                .map(|p| [p[0] as f64, p[1] as f64, p[2] as f64])
+                .collect();
+            let r_f = fillet.blend_radius as f64;
+            let mut rng = SplitMix64::new(45);
+            let mut band_pts: Vec<V3> = Vec::with_capacity(2500);
+            while band_pts.len() < 2500 {
+                let si = (rng.next_u64() as usize) % (poly.len() - 1);
+                let t = rng.next_f64();
+                let base = add(poly[si], scale(sub(poly[si + 1], poly[si]), t));
+                let u = rng.unit_dir();
+                let p = add(base, scale(u, rng.next_f64() * 2.5 * r_f));
+                band_pts.push(p);
+            }
+            let band_true: Vec<f64> = {
+                use rayon::prelude::*;
+                band_pts.par_iter().map(|&p| gt.distance(p)).collect()
+            };
+
+            let dc_bvhs: Vec<(String, &TriMesh, Bvh)> = dc_meshes
+                .iter()
+                .map(|(n, tm)| (n.clone(), tm, Bvh::build(tm)))
+                .collect();
+            let mut band_variants: Vec<(String, Box<dyn Field + '_>)> = vec![
+                ("field_visual".into(), Box::new(CsgField::visual(&node))),
+                ("tape".into(), Box::new(TapeField { compiled: &compiled })),
+            ];
+            if let Some((tm, bvh)) = &proxy_for_blend {
+                band_variants.push((
+                    "proxy_tess_sharp_tol0.05".into(),
+                    Box::new(ProxyField { mesh: tm, bvh, sign_field: &field }),
+                ));
+            }
+            for (n, tm, bvh) in &dc_bvhs {
+                band_variants.push((
+                    n.clone(),
+                    Box::new(ProxyField { mesh: tm, bvh, sign_field: &field }),
+                ));
+            }
+            for (vname, f) in &band_variants {
+                let errs: Vec<f64> = band_pts
+                    .iter()
+                    .zip(band_true.iter())
+                    .map(|(&p, &d)| f.eval(p) - d)
+                    .filter(|e| e.is_finite())
+                    .collect();
+                let s = Stats::from_signed(errs);
+                // Gradientennorm im Band.
+                let h = model_size * 1e-3;
+                let gnorms: Vec<f64> = band_pts
+                    .iter()
+                    .map(|&p| central_grad_norm(f.as_ref(), p, h))
+                    .filter(|g| g.is_finite())
+                    .collect();
+                let gdev = Stats::from_signed(gnorms.iter().map(|g| g - 1.0).collect());
+                band_rows.push(format!(
+                    "{},{vname},{},{:.6},{:.6},{:.6},{:.6},{:.4},{:.4}",
+                    scene.name, s.count, s.mean, s.p95, s.max, s.mean_signed, gdev.p95, gdev.max
+                ));
+                eprintln!(
+                    "  band {vname}: mean {:.4} p95 {:.4} max {:.4} bias {:+.4}",
+                    s.mean, s.p95, s.max, s.mean_signed
+                );
+            }
+        }
+
+        // ── Hybrid-Blend-Regel (Iteration-1-Regel: Band ≥ 4× Diskrepanz) ─
+        // Diskrepanz Δ = max |f − d_wahr| über die Nahfeld-Punkte.
+        // Gemessen für JEDEN verfügbaren Proxy — auch den (in der
+        // Fillet-Zone falschen) scharfen Tess-Proxy, um die Konsequenz
+        // eines geometrisch falschen Nahfelds im Blend zu beziffern.
+        let mut blend_proxies: Vec<(String, &TriMesh)> = Vec::new();
+        if let Some((tm, _)) = &proxy_for_blend {
+            blend_proxies.push(("proxy_tess_tol0.05".into(), tm));
+        }
+        if let Some((n, tm)) = dc_meshes.iter().last() {
+            blend_proxies.push((n.clone(), tm));
+        }
+        for (pname, tm) in &blend_proxies {
+            let tm: &TriMesh = tm;
+            let bvh = Bvh::build(tm);
+            let delta = pts
+                .iter()
+                .zip(dtrue.iter())
+                .filter(|(_, &d)| d.abs() < NEAR_BAND_REL * model_size)
+                .map(|(&p, &d)| (field.eval(p) - d).abs())
+                .fold(0.0f64, f64::max);
+            let tau_in = 1.0f64;
+            for mult in [1.0f64, 2.0, 4.0, 8.0] {
+                let width = (mult * delta).max(1e-6);
+                let h_field = FnField(|p: [f64; 3]| {
+                    let f = field.eval(p);
+                    let s = if f < 0.0 { -1.0 } else { 1.0 };
+                    let d_near = s * bvh.dist(tm, p);
+                    let w = smoothstep(tau_in, tau_in + width, f.abs());
+                    d_near * (1.0 - w) + f * w
+                });
+                // Überschätzung getrennt außen/innen: außen ist sie die
+                // Marsch-Sicherheits-Frage (Overstep), innen bedeutet
+                // positiver Fehler "Feld meldet zu wenig Tiefe" (Shell/
+                // Wandstärke) — dort erbt h jenseits des Bands schlicht
+                // den Feld-Fehler.
+                let mut max_over_out = f64::NEG_INFINITY;
+                let mut max_over_in = f64::NEG_INFINITY;
+                for (i, &p) in pts.iter().enumerate() {
+                    let e = h_field.eval(p) - dtrue[i];
+                    if !e.is_finite() {
+                        continue;
+                    }
+                    if dtrue[i] > 0.0 {
+                        max_over_out = max_over_out.max(e);
+                    } else {
+                        max_over_in = max_over_in.max(e);
+                    }
+                }
+                let hstep = model_size * 1e-3;
+                let max_grad = pts
+                    .iter()
+                    .map(|&p| central_grad_norm(&h_field, p, hstep))
+                    .filter(|g| g.is_finite())
+                    .fold(0.0f64, f64::max);
+                blend_rows.push(format!(
+                    "{},{pname},{:.4},{mult},{:.4},{:.6},{:.6},{:.4}",
+                    scene.name, delta, width, max_over_out, max_over_in, max_grad
+                ));
+                eprintln!(
+                    "  blend mult={mult}: Δ={delta:.4} width={width:.4} over_out={max_over_out:.6} over_in={max_over_in:.6} max_grad={max_grad:.4}"
+                );
+            }
+        }
+    }
+
+    // ── Dateien schreiben ────────────────────────────────────────────────
+    let stats_hdr = |p: &str| {
+        format!("{p}_count,{p}_mean,{p}_p95,{p}_max,{p}_bias")
+    };
+    let header = format!(
+        "scene,variant,tol,{},{},{},{},{},{},{},grad_dev_mean,grad_dev_p95,grad_dev_max,seam_jump_p95,ns_per_eval",
+        stats_hdr("near_out"), stats_hdr("near_in"), stats_hdr("mid_out"),
+        stats_hdr("mid_in"), stats_hdr("far_out"), stats_hdr("far_in"), stats_hdr("overall"),
+    );
+    write_csv(&out.join("summary.csv"), &header, &summary_rows);
+    write_csv(
+        &out.join("fillet_band.csv"),
+        "scene,variant,count,mean,p95,max,bias,grad_dev_p95,grad_dev_max",
+        &band_rows,
+    );
+    write_csv(
+        &out.join("blend_rule.csv"),
+        "scene,proxy,delta_mm,band_mult,band_mm,max_overshoot_out_mm,max_overshoot_in_mm,max_grad_norm",
+        &blend_rows,
+    );
+    std::fs::write(
+        out.join("weave_facts.json"),
+        serde_json::to_string_pretty(&facts).unwrap(),
+    )
+    .unwrap();
+    eprintln!("done → {}", out.display());
+}
+
+fn write_csv(path: &Path, header: &str, rows: &[String]) {
+    let mut f = std::fs::File::create(path).unwrap();
+    writeln!(f, "{header}").unwrap();
+    for r in rows {
+        writeln!(f, "{r}").unwrap();
+    }
+}
