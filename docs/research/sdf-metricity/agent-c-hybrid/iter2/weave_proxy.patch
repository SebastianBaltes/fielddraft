+// ───────────────────────── Szenenbau über die echte Feature-API ──────────────
+
+fn id(n: u32) -> FeatureId {
+    FeatureId::from_u32(n)
+}
+
+/// Regeneriert `calls` über die echte Registry und gibt die dekodierte
+/// Feature-Spine + gesammelte Edge-Fillets zurück (geklont, damit der
+/// Document-Borrow endet).
+fn regen(calls: &[FeatureCall]) -> (Vec<DecodedFeature>, Vec<EdgeFillet>) {
+    let registry = FeatureRegistry::with_builtins();
+    let mut doc = Document::default();
+    let mut ctx = Context::new(&mut doc);
+    registry.regenerate(&mut ctx, calls, None).unwrap();
+    (ctx.features.clone(), ctx.edge_fillets.clone())
+}
+
+/// S3: Step-Geometrie (Box − Box) → Kanten-Query-Hash der Rim-Kante
+/// (Feature-1×Feature-2), dann `fillet_edge` r=3 — exakt das Muster aus
+/// `features_tests::step_geometry` (DL-61), synchron via `weave_all`.
+fn build_fillet_scene(
+    blend_radius: f32,
+) -> (Vec<DecodedFeature>, Vec<EdgeFillet>) {
+    let registry = FeatureRegistry::with_builtins();
+    let mut doc = Document::default();
+    let mut ctx = Context::new(&mut doc);
+    registry
+        .regenerate(
+            &mut ctx,
+            &[
+                FeatureCall::new("box", id(1), json!({ "half_extents": [10.0, 10.0, 10.0] })),
+                FeatureCall::new(
+                    "box",
+                    id(2),
+                    json!({
+                        "half_extents": [5.0, 5.0, 5.0],
+                        "center": [0.0, 0.0, 10.0],
+                        "op": "remove",
+                        "targets": "qCreatedBy(1)",
+                    }),
+                ),
+            ],
+            None,
+        )
+        .unwrap();
+
+    // Synchroner Weave: genau so erzwingen es die Kernel-Tests — die
+    // Kanten-Query löst gegen das fertige B-Rep aus `weave_all` auf.
+    let woven = weave_all(&ctx.features);
+    assert_eq!(woven.len(), 1, "one connected body");
+    let (brep, _placement) = &woven[0];
+    let mut edge_hash = None;
+    for i in 0..brep.edges.len() {
+        let e = brep.edge(EdgeId(i as u32));
+        let (s0, s1) = (e.signature.0.feature_id(), e.signature.1.feature_id());
+        if (s0 == 1 && s1 == 2) || (s0 == 2 && s1 == 1) {
+            edge_hash = Some(TopoRef::from_edge(brep, EdgeId(i as u32)).id_hash);
+            break;
+        }
+    }
+    let edge_hash = edge_hash.expect("feature-1×feature-2 rim edge exists");
+
+    registry
+        .regenerate(
+            &mut ctx,
+            &[FeatureCall::new(
+                "fillet_edge",
+                id(3),
+                json!({ "edge": format!("qEdge({edge_hash})"), "blend_radius": blend_radius }),
+            )],
+            None,
+        )
+        .unwrap();
+    assert_eq!(ctx.edge_fillets.len(), 1, "one fillet resolved");
+    (ctx.features.clone(), ctx.edge_fillets.clone())
+}
