+// ───────────────────────── Mini-Vec + Punkt-Dreieck (Ericson) ────────────────
+// Übernommen aus Iteration 1 (agent-c-hybrid/lab): dependency-freier BVH.
+
+type V3 = [f64; 3];
+fn sub(a: V3, b: V3) -> V3 {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+fn add(a: V3, b: V3) -> V3 {
+    [a[0] + b[0], a[1] + b[1], a[2] + b[2]]
+}
+fn scale(a: V3, s: f64) -> V3 {
+    [a[0] * s, a[1] * s, a[2] * s]
+}
+fn dot(a: V3, b: V3) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn closest_on_tri(p: V3, a: V3, b: V3, c: V3) -> V3 {
+    let ab = sub(b, a);
+    let ac = sub(c, a);
+    let ap = sub(p, a);
+    let d1 = dot(ab, ap);
+    let d2 = dot(ac, ap);
+    if d1 <= 0.0 && d2 <= 0.0 {
+        return a;
+    }
+    let bp = sub(p, b);
+    let d3 = dot(ab, bp);
+    let d4 = dot(ac, bp);
+    if d3 >= 0.0 && d4 <= d3 {
+        return b;
+    }
+    let vc = d1 * d4 - d3 * d2;
+    if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0 {
+        let v = d1 / (d1 - d3);
+        return add(a, scale(ab, v));
+    }
+    let cp = sub(p, c);
+    let d5 = dot(ab, cp);
+    let d6 = dot(ac, cp);
+    if d6 >= 0.0 && d5 <= d6 {
+        return c;
+    }
+    let vb = d5 * d2 - d1 * d6;
+    if vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0 {
+        let w = d2 / (d2 - d6);
+        return add(a, scale(ac, w));
+    }
+    let va = d3 * d6 - d5 * d4;
+    if va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0 {
+        let w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
+        return add(b, scale(sub(c, b), w));
+    }
+    let denom = 1.0 / (va + vb + vc);
+    let v = vb * denom;
+    let w = vc * denom;
+    add(a, add(scale(ab, v), scale(ac, w)))
+}
+
+struct TriMesh {
+    v: Vec<V3>,
+    t: Vec<[u32; 3]>,
+}
+
+impl TriMesh {
+    /// Kernel-`Mesh` (f32-Positions + Index-Buffer) → f64-TriMesh.
+    fn from_kernel(mesh: &fielddraft_kernel::dc::Mesh) -> TriMesh {
+        let v: Vec<V3> = mesh
+            .positions
+            .chunks_exact(3)
+            .map(|c| [c[0] as f64, c[1] as f64, c[2] as f64])
+            .collect();
+        let t: Vec<[u32; 3]> =
+            mesh.indices.chunks_exact(3).map(|c| [c[0], c[1], c[2]]).collect();
+        TriMesh { v, t }
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Aabb64 {
+    min: V3,
+    max: V3,
+}
+impl Aabb64 {
+    const EMPTY: Aabb64 = Aabb64 { min: [f64::MAX; 3], max: [f64::MIN; 3] };
+    fn grow(&mut self, p: V3) {
+        for k in 0..3 {
+            self.min[k] = self.min[k].min(p[k]);
+            self.max[k] = self.max[k].max(p[k]);
+        }
+    }
+    fn dist2(&self, p: V3) -> f64 {
+        let mut d = 0.0;
+        for k in 0..3 {
+            let v = if p[k] < self.min[k] {
+                self.min[k] - p[k]
+            } else if p[k] > self.max[k] {
+                p[k] - self.max[k]
+            } else {
+                0.0
+            };
+            d += v * v;
+        }
+        d
+    }
+}
+
+struct BvhNode {
+    bb: Aabb64,
+    left: u32,
+    right: u32,
+    start: u32,
+    count: u32,
+}
+
+struct Bvh {
+    nodes: Vec<BvhNode>,
+    order: Vec<u32>,
+}
+
+impl Bvh {
+    fn build(mesh: &TriMesh) -> Bvh {
+        let n = mesh.t.len();
+        let mut order: Vec<u32> = (0..n as u32).collect();
+        let cents: Vec<V3> = mesh
+            .t
+            .iter()
+            .map(|t| {
+                let (a, b, c) =
+                    (mesh.v[t[0] as usize], mesh.v[t[1] as usize], mesh.v[t[2] as usize]);
+                scale(add(add(a, b), c), 1.0 / 3.0)
+            })
+            .collect();
+        let mut nodes = Vec::with_capacity(2 * n);
+        Self::build_rec(mesh, &cents, &mut order, 0, n, &mut nodes);
+        Bvh { nodes, order }
+    }
+    fn build_rec(
+        mesh: &TriMesh,
+        cents: &[V3],
+        order: &mut [u32],
+        start: usize,
+        count: usize,
+        nodes: &mut Vec<BvhNode>,
+    ) -> u32 {
+        let mut bb = Aabb64::EMPTY;
+        for &ti in &order[start..start + count] {
+            let t = mesh.t[ti as usize];
+            for &vi in &t {
+                bb.grow(mesh.v[vi as usize]);
+            }
+        }
+        let idx = nodes.len() as u32;
+        nodes.push(BvhNode { bb, left: 0, right: 0, start: start as u32, count: count as u32 });
+        if count <= 4 {
+            return idx;
+        }
+        let mut cb = Aabb64::EMPTY;
+        for &ti in &order[start..start + count] {
+            cb.grow(cents[ti as usize]);
+        }
+        let ext = sub(cb.max, cb.min);
+        let axis = if ext[0] >= ext[1] && ext[0] >= ext[2] {
+            0
+        } else if ext[1] >= ext[2] {
+            1
+        } else {
+            2
+        };
+        let seg = &mut order[start..start + count];
+        let mid = count / 2;
+        seg.select_nth_unstable_by(mid, |&a, &b| {
+            cents[a as usize][axis].partial_cmp(&cents[b as usize][axis]).unwrap()
+        });
+        let l = Self::build_rec(mesh, cents, order, start, mid, nodes);
+        let r = Self::build_rec(mesh, cents, order, start + mid, count - mid, nodes);
+        nodes[idx as usize].left = l;
+        nodes[idx as usize].right = r;
+        nodes[idx as usize].count = 0;
+        idx
+    }
+    /// Unsignierte Distanz Punkt→Mesh (exakter Nearest, BVH-Pruning).
+    fn dist(&self, mesh: &TriMesh, p: V3) -> f64 {
+        let mut best = f64::MAX;
+        let mut stack = [0u32; 64];
+        let mut sp = 0usize;
+        stack[sp] = 0;
+        sp += 1;
+        while sp > 0 {
+            sp -= 1;
+            let node = &self.nodes[stack[sp] as usize];
+            if node.bb.dist2(p) >= best {
+                continue;
+            }
+            if node.count > 0 {
+                for i in node.start..node.start + node.count {
+                    let t = mesh.t[self.order[i as usize] as usize];
+                    let q = closest_on_tri(
+                        p,
+                        mesh.v[t[0] as usize],
+                        mesh.v[t[1] as usize],
+                        mesh.v[t[2] as usize],
+                    );
+                    let d2 = {
+                        let d = sub(p, q);
+                        dot(d, d)
+                    };
+                    if d2 < best {
+                        best = d2;
+                    }
+                }
+            } else {
+                let (l, r) = (node.left, node.right);
+                let dl = self.nodes[l as usize].bb.dist2(p);
+                let dr = self.nodes[r as usize].bb.dist2(p);
+                let (first, second, dfirst, dsecond) =
+                    if dl <= dr { (l, r, dl, dr) } else { (r, l, dr, dl) };
+                if dsecond < best {
+                    stack[sp] = second;
+                    sp += 1;
+                }
+                if dfirst < best {
+                    stack[sp] = first;
+                    sp += 1;
+                }
+            }
+        }
+        best.sqrt()
+    }
+}
+
+/// Proxy-Feld: Betrag = BVH-Punkt-Mesh-Distanz, Vorzeichen aus dem
+/// (Schranken-)Feld — das Rezept aus Iteration 1 (Architektur-Skizze §2).
+struct ProxyField<'a> {
+    mesh: &'a TriMesh,
+    bvh: &'a Bvh,
+    sign_field: &'a dyn Field,
+}
+
+impl Field for ProxyField<'_> {
+    fn eval(&self, p: [f64; 3]) -> f64 {
+        let s = if self.sign_field.eval(p) < 0.0 { -1.0 } else { 1.0 };
+        s * self.bvh.dist(self.mesh, p)
+    }
+}
