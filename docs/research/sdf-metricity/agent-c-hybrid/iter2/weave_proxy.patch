+// ───────────────────────── Messhelfer ────────────────────────────────────────
+
+/// Banded-Report wie `metrics::distance_errors`, aber gegen VORBERECHNETE
+/// GT-Werte (die GT ist teuer; wir messen viele Varianten je Punktmenge).
+struct Banded {
+    near_out: Stats,
+    near_in: Stats,
+    mid_out: Stats,
+    mid_in: Stats,
+    far_out: Stats,
+    far_in: Stats,
+    overall: Stats,
+}
+
+fn banded(field: &dyn Field, pts: &[V3], dtrue: &[f64], model_size: f64) -> Banded {
+    let errs: Vec<(f64, f64)> = pts
+        .iter()
+        .zip(dtrue.iter())
+        .map(|(&p, &d)| (d, field.eval(p) - d))
+        .filter(|(d, e)| d.is_finite() && e.is_finite())
+        .collect();
+    let near = NEAR_BAND_REL * model_size;
+    let mid = MID_BAND_REL * model_size;
+    let band = |lo: f64, hi: f64, inside: bool| -> Stats {
+        Stats::from_signed(
+            errs.iter()
+                .filter(|(d, _)| {
+                    let a = d.abs();
+                    a >= lo && a < hi && ((*d < 0.0) == inside)
+                })
+                .map(|(_, e)| *e)
+                .collect(),
+        )
+    };
+    Banded {
+        near_out: band(0.0, near, false),
+        near_in: band(0.0, near, true),
+        mid_out: band(near, mid, false),
+        mid_in: band(near, mid, true),
+        far_out: band(mid, f64::INFINITY, false),
+        far_in: band(mid, f64::INFINITY, true),
+        overall: Stats::from_signed(errs.iter().map(|(_, e)| *e).collect()),
+    }
+}
+
+fn bench_ns(field: &dyn Field, pts: &[V3], n: usize) -> f64 {
+    let mut acc = 0.0f64;
+    for &p in pts.iter().take(1000) {
+        acc += field.eval(p);
+    }
+    let start = std::time::Instant::now();
+    for i in 0..n {
+        acc += field.eval(pts[i % pts.len()]);
+    }
+    let dt = start.elapsed().as_secs_f64();
+    std::hint::black_box(acc);
+    dt / n as f64 * 1e9
+}
+
+fn stats_csv(s: &Stats) -> String {
+    format!("{},{:.6},{:.6},{:.6},{:.6}", s.count, s.mean, s.p95, s.max, s.mean_signed)
+}
+
+/// Distanz Punkt → Polylinie (Segmente), für das Fillet-Band.
+fn dist_to_polyline(p: V3, poly: &[V3]) -> f64 {
+    let mut best = f64::MAX;
+    for w in poly.windows(2) {
+        let (a, b) = (w[0], w[1]);
+        let ab = sub(b, a);
+        let denom = dot(ab, ab);
+        let t = if denom > 0.0 { (dot(sub(p, a), ab) / denom).clamp(0.0, 1.0) } else { 0.0 };
+        let q = add(a, scale(ab, t));
+        let d = sub(p, q);
+        best = best.min(dot(d, d));
+    }
+    best.sqrt()
+}
+
+fn smoothstep(a: f64, b: f64, x: f64) -> f64 {
+    let t = ((x - a) / (b - a)).clamp(0.0, 1.0);
+    t * t * (3.0 - 2.0 * t)
+}
+
+fn central_grad_norm(f: &dyn Field, p: V3, h: f64) -> f64 {
+    let mut g = [0.0f64; 3];
+    for k in 0..3 {
+        let mut pp = p;
+        let mut pm = p;
+        pp[k] += h;
+        pm[k] -= h;
+        g[k] = (f.eval(pp) - f.eval(pm)) / (2.0 * h);
+    }
+    (g[0] * g[0] + g[1] * g[1] + g[2] * g[2]).sqrt()
+}
