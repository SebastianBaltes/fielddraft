+// ── Forschung #384 / Iteration 2 (Agent D): tiefenbewusstes march_relax ──
+//
+// Compile-Zeit-Analyse der smin-Schachtelung eines Tape-Pfads. Das
+// zirkuläre smin kombiniert die Gradienten seiner Zweige in QUADRATUR
+// (|∇f|² ≤ |∇a|² + |∇b|², Arc-Gewichte sind ein Einheitsvektor), harte
+// min/max/Morph nehmen den Winner-Branch (max). Daraus folgt für einen
+// koinzidenten Stack aus m geschachtelten smins die scharfe Schranke
+// L = √(1+m) (Iteration-1-Messung: exakt erreicht) — das flache 0.75
+// ist ab m ≥ 1 mit tiefem Überlapp unsicher (0.75·√2 > 1).
+
+/// Maximale Zahl geschachtelter smin-Ops (SmoothUnion/SmoothDifference)
+/// entlang eines Pfads des Baums. MaskedBlend zählt NICHT: sein
+/// kompiliertes Render-Feld ist durch den #382-Fade bereits ÷√2
+/// normalisiert (siehe [`lipschitz_sq_bound`]).
+pub fn max_smin_nesting(node: &BoundedCsg) -> u32 {
+    match node {
+        BoundedCsg::Empty
+        | BoundedCsg::Leaf { .. }
+        | BoundedCsg::Extrude { .. }
+        | BoundedCsg::Helix { .. }
+        | BoundedCsg::Sweep { .. }
+        | BoundedCsg::Revolve { .. } => 0,
+        BoundedCsg::SmoothUnion { left, right, .. }
+        | BoundedCsg::SmoothDifference { left, right, .. } => {
+            1 + max_smin_nesting(left).max(max_smin_nesting(right))
+        }
+        BoundedCsg::Union { left, right, .. }
+        | BoundedCsg::Difference { left, right, .. }
+        | BoundedCsg::Intersection { left, right, .. }
+        | BoundedCsg::Morph { left, right, .. }
+        | BoundedCsg::MaskedBlend { left, right, .. } => {
+            max_smin_nesting(left).max(max_smin_nesting(right))
+        }
+        BoundedCsg::Twist { inner, .. }
+        | BoundedCsg::Bend { inner, .. }
+        | BoundedCsg::Shell { inner, .. }
+        | BoundedCsg::Offset { inner, .. }
+        | BoundedCsg::Displace { inner, .. } => max_smin_nesting(inner),
+    }
+}
+
+/// Obere Schranke für L² des KOMPILIERTEN Render-Felds (Tape-Semantik,
+/// nicht `CsgNode::sdf`!), rein strukturell aus dem Baum:
+///
+/// * Leaves sind ≤1-Lipschitz (Gyroid/Thread/Custom normalisieren intern;
+///   Displace/Revolve-Restrisiken deckt weiterhin [`march_relax`]).
+/// * min/max/Morph: Winner-Branch → `max(L_a², L_b²)`.
+/// * smin (Fillet wie Chamfer): Quadratur → `L_a² + L_b²`
+///   (Chamfer: ((L_a+L_b)/√2)² ≤ L_a²+L_b²).
+/// * MaskedBlend: der #382-Render-Fade teilt durch √2 →
+///   `max(L_hard², L_blend²/2) ≤ max(L_a², L_b²)` — neutral.
+///
+/// Für einen koinzidenten Stack aus m smins über Einheits-Leaves ergibt
+/// das exakt `1 + m`, also die Politik `relax = 1/√(1+m)`.
+pub fn lipschitz_sq_bound(node: &BoundedCsg) -> f32 {
+    match node {
+        BoundedCsg::Empty
+        | BoundedCsg::Leaf { .. }
+        | BoundedCsg::Extrude { .. }
+        | BoundedCsg::Helix { .. }
+        | BoundedCsg::Sweep { .. }
+        | BoundedCsg::Revolve { .. } => 1.0,
+        BoundedCsg::SmoothUnion { left, right, .. }
+        | BoundedCsg::SmoothDifference { left, right, .. } => {
+            lipschitz_sq_bound(left) + lipschitz_sq_bound(right)
+        }
+        BoundedCsg::Union { left, right, .. }
+        | BoundedCsg::Difference { left, right, .. }
+        | BoundedCsg::Intersection { left, right, .. }
+        | BoundedCsg::Morph { left, right, .. }
+        | BoundedCsg::MaskedBlend { left, right, .. } => {
+            lipschitz_sq_bound(left).max(lipschitz_sq_bound(right))
+        }
+        BoundedCsg::Twist { inner, .. }
+        | BoundedCsg::Bend { inner, .. }
+        | BoundedCsg::Shell { inner, .. }
+        | BoundedCsg::Offset { inner, .. }
+        | BoundedCsg::Displace { inner, .. } => lipschitz_sq_bound(inner),
+    }
+}
+
+/// Tiefenbewusste Schritt-Dämpfung: heutiges per-Feature-[`march_relax`]
+/// UND-verknüpft mit `1/√(L²)` aus der smin-Schachtelungsanalyse.
+/// Für smin-freie Bäume identisch zum Status quo (keine Verlangsamung);
+/// auf einem koinzidenten m-Stack `1/√(1+m)`.
+pub fn march_relax_depth_aware(node: &BoundedCsg) -> f32 {
+    march_relax(node).min(1.0 / lipschitz_sq_bound(node).max(1.0).sqrt())
+}
