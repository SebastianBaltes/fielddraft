+//! Iteration 2, Experiment 4 (Agent D): tiefenbewusstes march_relax +
+//! Zweikanal-AD am echten Bytecode-Tape, in 3D gegen metricity-lab-GT.
+//!
+//! Läufe: `cargo run -p metricity-lab --release --bin iter2_relax_ad -- <outdir>`
+//!
+//! Teile:
+//!  A) Sphere-Trace-Sicherheit: Penetrationsrate/-tiefe für relax ∈
+//!     {1.0, 0.75, depth-aware 1/√(1+m)} auf koinzidenten/fast-koinzidenten
+//!     smin-Stacks (m=2,4,8), MaskedBlend-Stack und realen Fillet-Szenen;
+//!     Schrittzahl-Regression auf gutartigem Korpus.
+//!  B) Zweikanal-AD durchs Tape (`sdf_tape_ad::eval_opcodes_dual`):
+//!     Tie-Flächen-FD-Artefakt, vertrauensbandiertes Wurzel-Sampson auf
+//!     Offset-Isoflächen, Kosten AD vs 1 Eval vs 1+6 FD-Evals.
+
+use std::fmt::Write as _;
+use std::fs;
+use std::time::Instant;
+
+use fielddraft_kernel::bvh::BoundedCsg;
+use fielddraft_kernel::csg::{BlendMode, BlendProvenance, CsgNode};
+use fielddraft_kernel::sdf_compiler::{
+    compile_body, eval_opcodes_with_volumes, lipschitz_sq_bound, march_relax_depth_aware,
+    max_smin_nesting, CompiledSdf,
+};
+use fielddraft_kernel::sdf_tape_ad::eval_opcodes_dual;
+use fielddraft_protocol::{FeatureId, Primitive};
+
+use metricity_lab::ground_truth::central_gradient;
+use metricity_lab::scenes;
+use metricity_lab::util::{add, norm, normalize, scale, sub, SplitMix64};
+use metricity_lab::{Field, GroundTruth, GtOptions, TapeField};
+
+// ── Szenen ─────────────────────────────────────────────────────────
+
+fn sphere(i: u32, center: [f32; 3], radius: f32) -> CsgNode {
+    CsgNode::Leaf {
+        id: FeatureId::from_u32(i),
+        primitive: Primitive::Sphere { center, radius },
+    }
+}
+
+/// Koinzidenter (jitter=0) bzw. fast-koinzidenter smin-Stack:
+/// m SmoothUnion-Ops über m+1 Kugeln r=30 am (fast) selben Ort,
+/// r_blend=6 — der Quadratur-Adversar (L = √(1+m)).
+fn smin_stack(m_ops: usize, jitter: f32) -> (String, CsgNode) {
+    let mut rng = SplitMix64::new(0x57AC_0000 + m_ops as u64);
+    let mut node = sphere(1, [0.0; 3], 30.0);
+    for i in 0..m_ops {
+        let c = [
+            (jitter as f64 * (rng.next_f64() * 2.0 - 1.0)) as f32,
+            (jitter as f64 * (rng.next_f64() * 2.0 - 1.0)) as f32,
+            (jitter as f64 * (rng.next_f64() * 2.0 - 1.0)) as f32,
+        ];
+        node = CsgNode::SmoothUnion(
+            Box::new(node),
+            Box::new(sphere((i + 2) as u32, c, 30.0)),
+            6.0,
+            BlendMode::Fillet,
+        );
+    }
+    let tag = if jitter > 0.0 { "near" } else { "coin" };
+    (format!("stack_{tag}_m{m_ops:02}"), node)
+}
+
+/// MaskedBlend-Stack am selben Ort: prüft die Vorhersage, dass der
+/// #382-÷√2-Fade den Stack im TAPE Lipschitz-neutral macht (L ≤ 1).
+fn masked_stack(m_ops: usize) -> (String, CsgNode) {
+    let ring = vec![
+        [-30.0, 0.0, -30.0],
+        [30.0, 0.0, -30.0],
+        [30.0, 0.0, 30.0],
+        [-30.0, 0.0, 30.0],
+        [-30.0, 0.0, -30.0],
+    ];
+    let mut node = sphere(1, [0.0; 3], 30.0);
+    for i in 0..m_ops {
+        node = CsgNode::MaskedBlend {
+            a: Box::new(node),
+            b: Box::new(sphere((i + 2) as u32, [0.0; 3], 30.0)),
+            mask_polyline: ring.clone(),
+            mask_radius: 80.0, // Maske deckt die ganze Kugel — Blend überall aktiv
+            blend_radius: 6.0,
+            blend_mode: BlendMode::Fillet,
+            is_difference: false,
+            provenance: BlendProvenance::NONE,
+        };
+    }
+    (format!("mb_stack_m{m_ops:02}"), node)
+}
+
+/// Tief überlappende SmoothUnion zweier Kugeln (3D-Gegenstück zur
+/// 2D-cx=0.6-Konfiguration) — Neck-/Offset-Testszene.
+fn offset_smin() -> (String, CsgNode) {
+    let node = CsgNode::SmoothUnion(
+        Box::new(sphere(1, [-24.0, 0.0, 0.0], 40.0)),
+        Box::new(sphere(2, [24.0, 0.0, 0.0], 40.0)),
+        6.0,
+        BlendMode::Fillet,
+    );
+    ("offset_smin".into(), node)
+}
+
+struct Prepared {
+    name: String,
+    compiled: CompiledSdf,
+    m: u32,
+    lip_sq: f32,
+    relax_depth: f32,
+    model: f64,
+    lo: [f64; 3],
+    hi: [f64; 3],
+}
+
+fn prepare(name: &str, node: &CsgNode) -> Prepared {
+    let bounded = BoundedCsg::from_csg(node);
+    let compiled = compile_body(&bounded);
+    let aabb = node.aabb();
+    let lo = [aabb.min[0] as f64, aabb.min[1] as f64, aabb.min[2] as f64];
+    let hi = [aabb.max[0] as f64, aabb.max[1] as f64, aabb.max[2] as f64];
+    let model = (hi[0] - lo[0]).max(hi[1] - lo[1]).max(hi[2] - lo[2]);
+    Prepared {
+        name: name.to_string(),
+        m: max_smin_nesting(&bounded),
+        lip_sq: lipschitz_sq_bound(&bounded),
+        relax_depth: march_relax_depth_aware(&bounded),
+        compiled,
+        model,
+        lo,
+        hi,
+    }
+}
+
+fn tape_eval(c: &CompiledSdf, p: [f64; 3]) -> f64 {
+    eval_opcodes_with_volumes(&c.opcodes, [p[0] as f32, p[1] as f32, p[2] as f32], &c.volumes)
+        as f64
+}
+
+// ── Trace-Simulation ───────────────────────────────────────────────
+
+struct TraceStats {
+    rays: usize,
+    hits: usize,
+    misses: usize,
+    pen: usize,
+    pen_depth_mean: f64,
+    pen_depth_max: f64,
+    steps_mean_hit: f64,
+}
+
+/// Sphere-Trace-Simulation auf `eval_opcodes`: Rays von außen auf
+/// GT-Oberflächenpunkte, Schritt `t += max(f·relax, ε)`.
+/// Penetration = Hit-Punkt liegt hinter der wahren Fläche (GT signiert,
+/// GT auf der Tape-EIGENEN Nullmenge — kein Vorzeichen-Mismatch).
+fn trace(pre: &Prepared, gt: &GroundTruth<'_>, relax: f64, n_rays: usize, seed: u64) -> TraceStats {
+    let mut rng = SplitMix64::new(seed);
+    let surf = gt.surface_points();
+    let tol_hit = 2e-4 * pre.model;
+    let pen_tol = 1e-3 * pre.model;
+    let eps = tol_hit * 0.5;
+    let t_max = pre.model * 2.0;
+    let launch = 0.35 * pre.model;
+    let max_steps = 6000usize;
+
+    let mut hits = 0usize;
+    let mut misses = 0usize;
+    let mut pen = 0usize;
+    let mut pen_sum = 0.0f64;
+    let mut pen_max = 0.0f64;
+    let mut steps_sum = 0usize;
+
+    for _ in 0..n_rays {
+        let q = surf[(rng.next_u64() as usize) % surf.len()];
+        // Startpunkt außerhalb suchen (Feld > 0).
+        let mut o = [0.0f64; 3];
+        let mut ok = false;
+        for _ in 0..16 {
+            let u = rng.unit_dir();
+            o = add(q, scale(u, launch));
+            if tape_eval(&pre.compiled, o) > 0.05 * pre.model {
+                ok = true;
+                break;
+            }
+        }
+        if !ok {
+            continue;
+        }
+        // Ziel: Oberflächenpunkt mit leichtem tangentialem Jitter.
+        let jit = scale(rng.unit_dir(), 0.02 * pre.model);
+        let dir = match normalize(sub(add(q, jit), o)) {
+            Some(d) => d,
+            None => continue,
+        };
+        let mut t = 0.0f64;
+        let mut hit = false;
+        let mut steps = 0usize;
+        while steps < max_steps && t < t_max {
+            let p = add(o, scale(dir, t));
+            let f = tape_eval(&pre.compiled, p);
+            if f < tol_hit {
+                hit = true;
+                hits += 1;
+                steps_sum += steps;
+                let d_true = gt.distance(p);
+                if d_true < -pen_tol {
+                    pen += 1;
+                    pen_sum += -d_true;
+                    pen_max = pen_max.max(-d_true);
+                }
+                break;
+            }
+            t += (f * relax).max(eps);
+            steps += 1;
+        }
+        if !hit {
+            misses += 1;
+        }
+    }
+    TraceStats {
+        rays: n_rays,
+        hits,
+        misses,
+        pen,
+        pen_depth_mean: if pen > 0 { pen_sum / pen as f64 } else { 0.0 },
+        pen_depth_max: pen_max,
+        steps_mean_hit: if hits > 0 { steps_sum as f64 / hits as f64 } else { f64::NAN },
+    }
+}
+
+// ── AD-Helfer ──────────────────────────────────────────────────────
+
+fn ad_grad(c: &CompiledSdf, p: [f64; 3]) -> Option<(f64, [f64; 3])> {
+    eval_opcodes_dual(&c.opcodes, [p[0] as f32, p[1] as f32, p[2] as f32]).map(|d| {
+        (
+            d.v as f64,
+            [d.g[0] as f64, d.g[1] as f64, d.g[2] as f64],
+        )
+    })
+}
+
+fn main() {
+    let out_dir = std::env::args().nth(1).unwrap_or_else(|| "iter2_out".into());
+    fs::create_dir_all(&out_dir).expect("outdir");
+    let gt_opts = GtOptions::default();
+
+    // ── Szenenlisten ───────────────────────────────────────────────
+    let mut adversarial: Vec<(String, CsgNode)> = vec![];
+    for m in [2usize, 4, 8] {
+        adversarial.push(smin_stack(m, 0.0));
+        adversarial.push(smin_stack(m, 0.3));
+    }
+    adversarial.push(masked_stack(4));
+    adversarial.push(offset_smin());
+    for name in ["masked_blend_edge", "smin_chain_04"] {
+        let s = scenes::scene_by_name(name).unwrap();
+        adversarial.push((s.name, s.node));
+    }
+
+    let benign_names = [
+        "sphere",
+        "box",
+        "rot_box",
+        "thin_wall_02p0pct",
+        "tangent_spheres_m25p0pct",
+        "deep_csg_08",
+        "smin_chain_02",
+        "smin_chain_08",
+        "smin_chain_16",
+        "masked_blend_edge",
+    ];
+
+    // ── A) Trace-Sicherheit + Schrittzahlen ────────────────────────
+    let mut csv_adv = String::from(
+        "scene,m_smin,lip_sq,policy,relax,rays,hits,misses,pen,pen_rate,pen_depth_mean_mm,pen_depth_max_mm,steps_mean_hit\n",
+    );
+    let mut csv_ben = csv_adv.clone();
+
+    let mut run_traces = |list: &[(String, CsgNode)], csv: &mut String, n_rays: usize| {
+        for (name, node) in list {
+            let pre = prepare(name, node);
+            let tape_field = TapeField { compiled: &pre.compiled };
+            let t0 = Instant::now();
+            let gt = GroundTruth::build(&tape_field, pre.lo, pre.hi, &gt_opts);
+            eprintln!(
+                "[gt] {name}: {} surface pts, {:.1}s (m={}, L²={:.2}, relax_depth={:.3})",
+                gt.n_surface_points(),
+                t0.elapsed().as_secs_f64(),
+                pre.m,
+                pre.lip_sq,
+                pre.relax_depth
+            );
+            let policies: [(&str, f64); 3] = [
+                ("full_1.0", 1.0),
+                ("flat_0.75", 0.75),
+                ("depth_aware", pre.relax_depth as f64),
+            ];
+            for (pname, relax) in policies {
+                let st = trace(&pre, &gt, relax, n_rays, 0xBEEF ^ pre.m as u64);
+                writeln!(
+                    csv,
+                    "{},{},{:.3},{},{:.4},{},{},{},{},{:.4},{:.4},{:.4},{:.2}",
+                    name,
+                    pre.m,
+                    pre.lip_sq,
+                    pname,
+                    relax,
+                    st.rays,
+                    st.hits,
+                    st.misses,
+                    st.pen,
+                    st.pen as f64 / st.hits.max(1) as f64,
+                    st.pen_depth_mean,
+                    st.pen_depth_max,
+                    st.steps_mean_hit
+                )
+                .unwrap();
+                eprintln!(
+                    "  {pname:<12} relax={relax:.3}: hits {}/{} pen {} ({:.1}%), depth mean {:.3} max {:.3} mm, steps {:.1}",
+                    st.hits, st.rays, st.pen,
+                    100.0 * st.pen as f64 / st.hits.max(1) as f64,
+                    st.pen_depth_mean, st.pen_depth_max, st.steps_mean_hit
+                );
+            }
+        }
+    };
+
+    run_traces(&adversarial, &mut csv_adv, 400);
+    let benign: Vec<(String, CsgNode)> = benign_names
+        .iter()
+        .map(|n| {
+            let s = scenes::scene_by_name(n).unwrap();
+            (s.name, s.node)
+        })
+        .collect();
+    run_traces(&benign, &mut csv_ben, 400);
+    fs::write(format!("{out_dir}/trace_adversarial.csv"), &csv_adv).unwrap();
+    fs::write(format!("{out_dir}/trace_benign.csv"), &csv_ben).unwrap();
+
+    // ── B0) AD-Sanity: Wert-Parität + Gradient vs FD (glatte Zonen) ─
+    let mut csv_sane = String::from("scene,n,max_val_diff,grad_normdiff_med,grad_normdiff_p95\n");
+    for (name, node) in adversarial.iter().chain(benign.iter().take(6)) {
+        let pre = prepare(name, node);
+        let tape_field = TapeField { compiled: &pre.compiled };
+        let mut rng = SplitMix64::new(0x5A5A);
+        let mut max_dv = 0.0f64;
+        let mut diffs: Vec<f64> = vec![];
+        let mut n_used = 0;
+        for _ in 0..3000 {
+            let p = [
+                rng.range(pre.lo[0], pre.hi[0]),
+                rng.range(pre.lo[1], pre.hi[1]),
+                rng.range(pre.lo[2], pre.hi[2]),
+            ];
+            let Some((v, g)) = ad_grad(&pre.compiled, p) else { continue };
+            n_used += 1;
+            max_dv = max_dv.max((v - tape_eval(&pre.compiled, p)).abs());
+            let gf = central_gradient(&tape_field, p, 1e-3 * pre.model);
+            let dn = norm(sub(g, gf));
+            diffs.push(dn);
+        }
+        diffs.sort_by(|a, b| a.total_cmp(b));
+        if !diffs.is_empty() {
+            writeln!(
+                csv_sane,
+                "{},{},{:.3e},{:.4},{:.4}",
+                name,
+                n_used,
+                max_dv,
+                diffs[diffs.len() / 2],
+                diffs[diffs.len() * 95 / 100]
+            )
+            .unwrap();
+        } else {
+            writeln!(csv_sane, "{name},0,unsupported,,").unwrap();
+        }
+    }
+    fs::write(format!("{out_dir}/sanity_ad.csv"), &csv_sane).unwrap();
+    eprintln!("[sanity] geschrieben");
+
+    // ── B1) FD-Tie-Flächen-Artefakt in 3D ─────────────────────────
+    // Harte Union, überlappend: außen ist f exakt (= d_wahr); an der
+    // Naht mittelt FD beide Äste → f/|g_fd| > d_wahr. AD: Winner-Branch.
+    let mut csv_fd = String::from(
+        "scene,grad_kind,h_mm,n,ratio_mean,ratio_p99,ratio_max,frac_over_1p05\n",
+    );
+    for scene_name in ["tangent_spheres_m25p0pct", "thin_wall_02p0pct"] {
+        let s = scenes::scene_by_name(scene_name).unwrap();
+        let pre = prepare(&s.name, &s.node);
+        let tape_field = TapeField { compiled: &pre.compiled };
+        let gt = GroundTruth::build(&tape_field, pre.lo, pre.hi, &gt_opts);
+        let mut rng = SplitMix64::new(0xF00D);
+        let surf = gt.surface_points();
+        let mut pts: Vec<[f64; 3]> = vec![];
+        while pts.len() < 3000 {
+            let q = surf[(rng.next_u64() as usize) % surf.len()];
+            let u = rng.unit_dir();
+            let p = add(q, scale(u, rng.range(0.0, 0.03 * pre.model)));
+            if tape_eval(&pre.compiled, p) > 1e-3 * pre.model {
+                pts.push(p);
+            }
+        }
+        let kinds: Vec<(String, f64)> = vec![
+            ("fd".into(), 1e-2 * pre.model),
+            ("fd".into(), 1e-3 * pre.model),
+            ("fd".into(), 1e-4 * pre.model),
+            ("ad".into(), 0.0),
+        ];
+        for (kind, h) in kinds {
+            let mut ratios: Vec<f64> = vec![];
+            for &p in &pts {
+                let f = tape_eval(&pre.compiled, p);
+                let gnorm = if kind == "fd" {
+                    norm(central_gradient(&tape_field, p, h))
+                } else {
+                    match ad_grad(&pre.compiled, p) {
+                        Some((_, g)) => norm(g),
+                        None => continue,
+                    }
+                };
+                if gnorm < 1e-6 {
+                    continue;
+                }
+                let d_true = gt.distance(p);
+                if d_true < 5e-4 * pre.model {
+                    continue;
+                }
+                ratios.push((f / gnorm) / d_true);
+            }
+            ratios.sort_by(|a, b| a.total_cmp(b));
+            let n = ratios.len();
+            if n == 0 {
+                continue;
+            }
+            let mean = ratios.iter().sum::<f64>() / n as f64;
+            let over = ratios.iter().filter(|r| **r > 1.05).count() as f64 / n as f64;
+            writeln!(
+                csv_fd,
+                "{},{},{:.4},{},{:.4},{:.4},{:.4},{:.4}",
+                scene_name,
+                kind,
+                h,
+                n,
+                mean,
+                ratios[n * 99 / 100],
+                ratios[n - 1],
+                over
+            )
+            .unwrap();
+            eprintln!(
+                "[fd-tie] {scene_name} {kind} h={h:.3}: max ratio {:.3}, p99 {:.3}, >1.05: {:.1}%",
+                ratios[n - 1],
+                ratios[n * 99 / 100],
+                over * 100.0
+            );
+        }
+    }
+    fs::write(format!("{out_dir}/fd_vs_ad_ties.csv"), &csv_fd).unwrap();
+
+    // ── B2) Vertrauensbandiertes Wurzel-Sampson auf Offset-Isoflächen ─
+    // Isofläche {F_variante = δ} entlang der Außen-Normalen suchen; die
+    // wahre Distanz des Treffpunkts zur Nullmenge (GT) sollte δ sein.
+    let r_blend = 6.0f64;
+    let mut csv_off = String::from(
+        "scene,delta_mm,variant,n,relerr_min,relerr_mean,relerr_max\n",
+    );
+    for (name, node) in [offset_smin(), smin_stack(4, 0.0)] {
+        let pre = prepare(&name, &node);
+        let tape_field = TapeField { compiled: &pre.compiled };
+        let gt = GroundTruth::build(&tape_field, pre.lo, pre.hi, &gt_opts);
+        let surf = gt.surface_points();
+        let mut rng = SplitMix64::new(0x0FF5E7);
+        // Variante: 0 = roh, 1 = Sampson (AD), 2 = Sampson bandiert.
+        let variant_eval = |p: [f64; 3], variant: usize| -> Option<f64> {
+            match variant {
+                0 => Some(tape_eval(&pre.compiled, p)),
+                _ => {
+                    let (f, g) = ad_grad(&pre.compiled, p)?;
+                    let gn = norm(g).max(0.25);
+                    if variant == 1 {
+                        Some(f / gn)
+                    } else {
+                        // Band: volle Korrektur für |f| ≤ r_blend, smoothstep-
+                        // Ausblendung bis 2·r_blend, außerhalb roh.
+                        let x = (((f.abs() - r_blend) / r_blend).clamp(0.0, 1.0)) as f64;
+                        let fade = 1.0 - x * x * (3.0 - 2.0 * x);
+                        let g_eff = 1.0 + (gn - 1.0) * fade;
+                        Some(f / g_eff)
+                    }
+                }
+            }
+        };
+        for delta in [1.0f64, 2.0, 3.0, 6.0, 12.0, -2.0] {
+            for variant in 0..3usize {
+                let vname = ["raw", "sampson", "sampson_banded"][variant];
+                let mut errs: Vec<f64> = vec![];
+                let mut tries = 0;
+                while errs.len() < 250 && tries < 4000 {
+                    tries += 1;
+                    let q = surf[(rng.next_u64() as usize) % surf.len()];
+                    let Some((_, gq)) = ad_grad(&pre.compiled, q) else { break };
+                    let Some(nrm) = normalize(gq) else { continue };
+                    let dir = if delta >= 0.0 { nrm } else { scale(nrm, -1.0) };
+                    // Ersten Crossing-Punkt von F_var = δ suchen + Bisektion.
+                    let t_lim = delta.abs() * 3.0 + 3.0 * r_blend;
+                    let mut t_lo = 0.0f64;
+                    let mut found = None;
+                    let mut steps = 0;
+                    let mut t = 0.0f64;
+                    let target = delta;
+                    let sgn = delta.signum();
+                    while t < t_lim && steps < 400 {
+                        let p = add(q, scale(dir, t));
+                        let Some(v) = variant_eval(p, variant) else { break };
+                        if sgn * (v - target) >= 0.0 && t > 0.0 {
+                            found = Some((t_lo, t));
+                            break;
+                        }
+                        t_lo = t;
+                        t += 0.25;
+                        steps += 1;
+                    }
+                    let Some((mut a, mut b)) = found else { continue };
+                    for _ in 0..40 {
+                        let mid = 0.5 * (a + b);
+                        let p = add(q, scale(dir, mid));
+                        let v = variant_eval(p, variant).unwrap_or(target);
+                        if sgn * (v - target) >= 0.0 {
+                            b = mid;
+                        } else {
+                            a = mid;
+                        }
+                    }
+                    let p = add(q, scale(dir, 0.5 * (a + b)));
+                    let d_true = gt.distance(p);
+                    // relerr: wie weit liegt die gefundene Isofläche von der
+                    // Soll-Distanz |δ| entfernt (signiert; − = zu nah).
+                    errs.push((d_true.abs() - delta.abs()) / delta.abs());
+                }
+                if errs.is_empty() {
+                    continue;
+                }
+                errs.sort_by(|x, y| x.total_cmp(y));
+                let mean = errs.iter().sum::<f64>() / errs.len() as f64;
+                writeln!(
+                    csv_off,
+                    "{},{},{},{},{:.4},{:.4},{:.4}",
+                    name,
+                    delta,
+                    vname,
+                    errs.len(),
+                    errs[0],
+                    mean,
+                    errs[errs.len() - 1]
+                )
+                .unwrap();
+                eprintln!(
+                    "[offset] {name} δ={delta} {vname}: relerr min {:.3} mean {:.3} max {:.3} (n={})",
+                    errs[0], mean, errs[errs.len() - 1], errs.len()
+                );
+            }
+        }
+    }
+    fs::write(format!("{out_dir}/sampson_offsets.csv"), &csv_off).unwrap();
+
+    // ── B3) Kosten: 1 Eval vs Dual-Eval vs 1+6 FD-Evals ────────────
+    let mut csv_cost = String::from(
+        "scene,opcodes,value_ns,dual_ns,fd7_ns,dual_over_value,fd7_over_value\n",
+    );
+    let cost_list = vec![
+        smin_stack(4, 0.0),
+        offset_smin(),
+        {
+            let s = scenes::scene_by_name("masked_blend_edge").unwrap();
+            (s.name, s.node)
+        },
+        {
+            let s = scenes::scene_by_name("deep_csg_08").unwrap();
+            (s.name, s.node)
+        },
+    ];
+    for (name, node) in cost_list {
+        let pre = prepare(&name, &node);
+        let mut rng = SplitMix64::new(0xC057);
+        let pts: Vec<[f32; 3]> = (0..4096)
+            .map(|_| {
+                [
+                    rng.range(pre.lo[0], pre.hi[0]) as f32,
+                    rng.range(pre.lo[1], pre.hi[1]) as f32,
+                    rng.range(pre.lo[2], pre.hi[2]) as f32,
+                ]
+            })
+            .collect();
+        let n = 300_000usize;
+        let h = (1e-3 * pre.model) as f32;
+        let bench = |f: &dyn Fn([f32; 3]) -> f32| -> f64 {
+            let mut acc = 0.0f32;
+            for p in pts.iter().take(1000) {
+                acc += f(*p);
+            }
+            let t0 = Instant::now();
+            for i in 0..n {
+                acc += f(pts[i % pts.len()]);
+            }
+            let dt = t0.elapsed().as_secs_f64();
+            std::hint::black_box(acc);
+            dt / n as f64 * 1e9
+        };
+        let ops = &pre.compiled.opcodes;
+        let vols = &pre.compiled.volumes;
+        let v_ns = bench(&|p| eval_opcodes_with_volumes(ops, p, vols));
+        let d_ns = bench(&|p| eval_opcodes_dual(ops, p).map(|d| d.v).unwrap_or(0.0));
+        let fd_ns = bench(&|p| {
+            let mut acc = eval_opcodes_with_volumes(ops, p, vols);
+            for ax in 0..3 {
+                let mut pp = p;
+                pp[ax] += h;
+                acc += eval_opcodes_with_volumes(ops, pp, vols);
+                pp[ax] -= 2.0 * h;
+                acc += eval_opcodes_with_volumes(ops, pp, vols);
+            }
+            acc
+        });
+        writeln!(
+            csv_cost,
+            "{},{},{:.1},{:.1},{:.1},{:.2},{:.2}",
+            name,
+            pre.compiled.opcodes.len(),
+            v_ns,
+            d_ns,
+            fd_ns,
+            d_ns / v_ns,
+            fd_ns / v_ns
+        )
+        .unwrap();
+        eprintln!(
+            "[cost] {name}: value {v_ns:.0} ns, dual {d_ns:.0} ns ({:.2}×), fd7 {fd_ns:.0} ns ({:.2}×)",
+            d_ns / v_ns,
+            fd_ns / v_ns
+        );
+    }
+    fs::write(format!("{out_dir}/ad_cost.csv"), &csv_cost).unwrap();
+
+    eprintln!("Fertig. Ergebnisse in {out_dir}/");
+}
