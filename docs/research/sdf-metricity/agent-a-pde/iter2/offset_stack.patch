+
+        // (1) plate_boss: Punkte in der Platte unter dem Boss-Fuß —
+        // |f| misst zur PHANTOM-Deckelfläche (Union innen kaputt).
+        let mut pts = Vec::new();
+        for &r in &[0.0, 3.0, 6.0, 9.0] {
+            for ka in 0..6 {
+                let a = ka as f64 / 6.0 * std::f64::consts::TAU + 0.3;
+                for &y in &[5.0, 8.0, 9.5] {
+                    let p = [r * a.cos(), y, r * a.sin()];
+                    if d_true_boss(p) < 0.0 {
+                        pts.push(p);
+                    }
+                    if r == 0.0 {
+                        break;
+                    }
+                }
+                if r == 0.0 {
+                    break;
+                }
+            }
+        }
+        // (2) plate_bore: dünnste Wand (4 mm zwischen Bohrung und x-Fläche)
+        // — Differenz innen ist beweisbar exakt (Negativ-Kontrolle).
+        let mut pts_bore = Vec::new();
+        for &x in &[36.5, 37.0, 38.0, 39.0, 39.5] {
+            for &y in &[-6.0, 0.0, 6.0] {
+                for &z in &[-4.0, 0.0, 4.0] {
+                    let p = [x, y, z];
+                    if d_true_bore(p) < 0.0 {
+                        pts_bore.push(p);
+                    }
+                }
+            }
+        }
+
+        for (scene, pts, f, cnt, truth) in [
+            (
+                "plate_boss_under_boss",
+                &pts,
+                &f_boss as &dyn Field,
+                Counting::new(&f_boss),
+                d_true_boss as fn([f64; 3]) -> f64,
+            ),
+            (
+                "plate_bore_thin_wall",
+                &pts_bore,
+                &f_bore as &dyn Field,
+                Counting::new(&f_bore),
+                d_true_bore as fn([f64; 3]) -> f64,
+            ),
+        ] {
+            // roh: Tiefe = |f|
+            let errs: Vec<f64> = pts.iter().map(|&p| -f.eval(p) - truth(p).abs()).collect();
+            let st = stat_of(errs);
+            csv.row(format!(
+                "{scene},raw,{},{:.6},{:.6},{:.6},{:.6},1,0.0",
+                st.n, st.mean_abs, st.p95, st.max_abs, st.bias
+            ));
+            eprintln!(
+                "  {scene}/raw: n={} mean={:.4} max={:.4} bias={:+.4}",
+                st.n, st.mean_abs, st.max_abs, st.bias
+            );
+            // Hopf–Lax mit wachsendem Richtungsbudget.
+            for n_dirs in [32usize, 64, 128] {
+                let hd = fib_dirs(n_dirs);
+                cnt.reset();
+                let t0 = Instant::now();
+                let errs: Vec<f64> = pts
+                    .iter()
+                    .map(|&p| hopf_lax_depth(&cnt, p, &hd, 1e-3, 60.0) - truth(p).abs())
+                    .collect();
+                let us = t0.elapsed().as_secs_f64() * 1e6 / pts.len().max(1) as f64;
+                let epq = cnt.count() as f64 / pts.len().max(1) as f64;
+                let st = stat_of(errs);
+                csv.row(format!(
+                    "{scene},hopflax{n_dirs},{},{:.6},{:.6},{:.6},{:.6},{:.0},{:.1}",
+                    st.n, st.mean_abs, st.p95, st.max_abs, st.bias, epq, us
+                ));
+                eprintln!(
+                    "  {scene}/hopflax{n_dirs}: n={} mean={:.4} max={:.4} bias={:+.4} | \
+                     {:.0} evals/q {:.1} µs/q",
+                    st.n, st.mean_abs, st.max_abs, st.bias, epq, us
+                );
+            }
+        }
+        csv.write();
+    }
+
+    eprintln!("done → {}", out.display());
+}
