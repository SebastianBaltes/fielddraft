+/// #384 experiment switch: `true` = IQ Circular-CD smin (1-Lipschitz distance
+/// under-bound), `false` = legacy circular-geometrical smin (exact arc
+/// distance in the arc region, √2-Lipschitz). Both share the same zero set.
+/// Initialised from env `FD_SMIN_CIRC_CD` ("0" = legacy; unset/other = CD),
+/// runtime-flippable for A/B measurement. Experiment-only; a production
+/// rollout would hard-swap the formula.
+pub fn smin_circ_cd_enabled() -> &'static std::sync::atomic::AtomicBool {
+    static S: std::sync::OnceLock<std::sync::atomic::AtomicBool> = std::sync::OnceLock::new();
+    S.get_or_init(|| {
+        std::sync::atomic::AtomicBool::new(
+            std::env::var("FD_SMIN_CIRC_CD").map(|v| v != "0").unwrap_or(true),
+        )
+    })
+}
+
+/// IQ's Circular (CD family) smooth minimum:
+/// `min(a,b) − (r/2)·(1 + h − √(1 − h·(h−2)))` with `h = max(r − |a−b|, 0)/r`.
+/// Zero set identical to the circular-geometrical [`smin_poly`] (the exact
+/// circle `(r−a)² + (r−b)² = r²` in the two distances' plane); the blend is a
+/// convex combination (`∂f/∂a + ∂f/∂b = 1`, both in `[0,1]`), hence
+/// 1-Lipschitz and a guaranteed distance UNDER-estimator. Max undershoot below
+/// `min` is `(1 − 1/√2)·r ≈ 0.293·r` on the seam bisector (`a = b`).
+pub(crate) fn smin_circ_cd(da: f32, db: f32, r: f32) -> f32 {
+    if r <= 0.0 {
+        return da.min(db);
+    }
+    let h = (r - (da - db).abs()).max(0.0) / r;
+    da.min(db) - r * 0.5 * (1.0 + h - (1.0 - h * (h - 2.0)).sqrt())
+}
