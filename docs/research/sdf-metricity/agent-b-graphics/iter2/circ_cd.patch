+/// Generic IQ Circular-CD smin. Mirrors `crate::csg::smin_circ_cd`:
+/// `min(a,b) − (r/2)·(1 + h − √(1 − h·(h−2)))`, `h = max(r − |a−b|, 0)/r`.
+fn smin_circ_cd_generic<T: DualNum<f64> + Copy + PartialOrd>(da: T, db: T, r: T) -> T {
+    if r.re() <= 0.0 {
+        return if da < db { da } else { db };
+    }
+    let zero = T::from(0.0);
+    let one = T::from(1.0);
+    let hn = r - (da - db).abs();
+    let h = (if hn > zero { hn } else { zero }) / r;
+    let min_ab = if da < db { da } else { db };
+    min_ab - r * T::from(0.5) * (one + h - safe_sqrt(one - h * (h - T::from(2.0))))
+}
