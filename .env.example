# FieldDraft — per-instance deployment/webapp config.
#
# Copy this file to `.env` (gitignored) and adjust per checkout so that two
# instances — the primary `fielddraft` and the agent `fielddraft-a` — can run
# side by side without colliding on host ports.
#
# Consumed by:
#   - justfile        (`set dotenv-load := true` exports these into recipes;
#                       Vite reads FIELDDRAFT_WEB_PORT for the dev server)
#   - vite.config.ts  (dev-server port via loadEnv, falls back to 5173)
#   - docker-compose.yml (host-side port mappings via ${VAR:-default})
#
# The values below are the DEFAULTS used by the primary `fielddraft` instance.
# The `fielddraft-a` checkout offsets: WEB 5174, SERVER 8090, DB 3317.
#
# Port-Abstimmung mit dem ClaudeDraft-Main-Agenten (2026-07-07): 8081 ist als
# Slave-Daemon websocket_addr reserviert (latenter Konflikt — fielddraft-a
# nutzt daher 8090, NICHT 8081); 9091–9099 sind ClaudeDraft-System-Ports,
# 3306 gehört der earthdawnwiki-DB, 8790/8792/8794 sind earthdawnwiki-Webports.
# Empfohlene Blöcke für Dev-Stacks: Backends 809x, DBs 331x — Primär 3316,
# fielddraft-a 3317 („+1 auf 3316", nicht „+1 auf 3306").

# Human-readable instance label (no functional effect; handy in logs/banners).
FIELDDRAFT_INSTANCE=fielddraft

# Vite dev server (just dev) and docker `web` host port. NOTE: the ClaudeDraft
# webapp launcher reads .claudedraft.json (static JSON, no .env interpolation),
# so keep its `port` in sync with this value per instance.
FIELDDRAFT_WEB_PORT=5173

# Go backend (docker `server`) host port.
FIELDDRAFT_SERVER_PORT=8080

# MariaDB (docker `db`) host port. 3306 is taken by the earthdawnwiki DB on
# this node — the primary instance uses 3316 (fielddraft-a: 3317).
FIELDDRAFT_DB_PORT=3316

# Docker Compose project name — namespaces containers/volumes/networks so two
# stacks don't clash. Defaults to the checkout directory name if unset.
COMPOSE_PROJECT_NAME=fielddraft

# ── Onshape import (optional) ────────────────────────────────────────────────
# The browser cannot call Onshape directly (no CORS, and the secret must never
# reach the bundle), so the Go server proxies and signs the two read endpoints.
# Unset → /api/onshape/* answers 503 "onshape not configured" and the import
# dialog says exactly that.
#
# Key pair from https://dev-portal.onshape.com → API keys. The key is an
# IDENTITY, not a public-data pass: it reads whatever its Onshape account may
# read — which is why the proxy routes sit behind requireAuth.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# ONSHAPE_URL=https://cad.onshape.com   # optional, this is the default
